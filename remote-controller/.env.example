# Backend WebSocket URL (auto-detects if not set)
# VITE_BACKEND_WS_URL=ws://localhost:8000/ws/remote

# Backend API URL (auto-detects if not set)
# VITE_BACKEND_API_URL=http://localhost:8000

# For production/ngrok, set these to your ngrok backend URL:
# VITE_BACKEND_WS_URL=wss://your-backend.ngrok-free.app/ws/remote
# VITE_BACKEND_API_URL=https://your-backend.ngrok-free.app
